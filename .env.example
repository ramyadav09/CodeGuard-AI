# CodeGuard AI Environment Variables

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here

# AI Provider Configuration
# AI_PROVIDER options: gemini | nvidia | mock (default: mock when no API key provided)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration — Neon PostgreSQL (Required for production)
# Get your connection string from: https://console.neon.tech → Connection Details
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

